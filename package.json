{
  "name": "x-ai-signal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:brave": "wxt -b chrome",
    "dev:chrome": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "fix": "biome check --write",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "wxt prepare && tsc --noEmit",
    "check": "biome check && pnpm typecheck",
    "verify": "pnpm check && pnpm test && pnpm build:chrome && pnpm build:firefox"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "linkedom": "^0.18.12",
    "typescript": "^6.0.3",
    "wxt": "^0.20.27"
  },
  "packageManager": "pnpm@11.9.0"
}
